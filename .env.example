# Get a free Gemini API key at https://aistudio.google.com/apikey
# Never commit a real key. This file is only a template.
GEMINI_API_KEY=

# Optional: force one model. By default the server tries
# gemini-3.5-flash-lite, then gemini-3.8-flash, then gemini-3.1-flash-lite, then a rule-based fallback.
# GEMINI_MODEL=

# Optional. When set, /api/diagnose, /api/check-quote, /api/parts-check and /api/parts-prices
# need the header x-martigence-key with this value (this app's own page still works).
# Leave empty in this template. Never commit the real value.
# MARTIGENCE_PROXY_KEY=

# Optional. Defaults to 8080. Hosting platforms set this for you.
# PORT=8080
